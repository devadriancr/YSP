<?xml version="1.0" encoding="UTF-8"?>
<!--
    IIS: the site must point to this "public" folder, never to the project root,
    so .env, storage and vendor are not reachable from the browser.
    Requires the IIS URL Rewrite module and PHP registered as a FastCGI handler.
-->
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <rule name="Laravel: redirect trailing slash" stopProcessing="true">
                    <match url="^(.*)/$" ignoreCase="false" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                    </conditions>
                    <action type="Redirect" redirectType="Permanent" url="/{R:1}" />
                </rule>
                <rule name="Laravel: front controller" stopProcessing="true">
                    <match url="^" ignoreCase="false" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php" />
                </rule>
            </rules>
        </rewrite>

        <security>
            <requestFiltering removeServerHeader="true">
                <!-- Big vendors send many DI rows in one request (50 MB) -->
                <requestLimits maxAllowedContentLength="52428800" />
                <hiddenSegments>
                    <add segment=".env" />
                    <add segment=".git" />
                </hiddenSegments>
            </requestFiltering>
        </security>

        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
            </customHeaders>
        </httpProtocol>
    </system.webServer>
</configuration>
